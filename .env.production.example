# --- Server Ports ---
PORT=5000
HOST_PORT=5000
MQTT_TCP_PORT=1884
MQTT_WS_PORT=1885

# --- Database ---
DB_NAME=catchsensor
DB_USER=catchsensor_user
DB_PASSWORD=your_secure_password
DB_ROOT_PASSWORD=your_root_password
DB_HOST=catchsensor_db
DB_PORT=3306

# --- JWT ---
JWT_SECRET=generate_a_long_random_string_here

# --- Pushover (Optional) ---
PUSHOVER_API_TOKEN=your_app_token

# --- Encryption ---
MASTER_SALT=generate_a_long_random_salt_here
AES_SECRET_KEY=deprecated_will_be_removed

# --- MQTT (Internal Broker is on 1884) ---
INTERNAL_MQTT_USER=alex
INTERNAL_MQTT_PASS=your_secure_mqtt_password
NBIOT_MQTT_BROKER=catchsensor_app
NBIOT_MQTT_PORT=1884
 
 #   O p t i o n a l :   T o p i c   A n o n y m i z a t i o n   ( h i d e s   I M E I   i n   M Q T T   t o p i c )  
 #   I f   t r u e ,   t o p i c s   w i l l   b e   c a t c h e s / H A S H / d a t a   i n s t e a d   o f   c a t c h e s / I M E I / d a t a  
 M Q T T _ A N O N Y M I Z E _ T O P I C S = f a l s e  

# --- Mail Server (IONOS SMTP) ---
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=noreply@your-domain.de
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@your-domain.de
SMTP_FROM_NAME=CatchSensor