# --- Database ---
DB_NAME=catchsensor
DB_USER=catchsensor_user
DB_PASSWORD=your_secure_password
DB_ROOT_PASSWORD=your_root_password
DB_HOST=catchsensor_db
DB_PORT=3306

# --- JWT ---
JWT_SECRET=generate_a_long_random_string_here

# --- Pushover (Optional) ---
PUSHOVER_API_TOKEN=your_app_token

# --- Encryption ---
MASTER_SALT=generate_a_long_random_salt_here
AES_SECRET_KEY=deprecated_will_be_removed

# --- MQTT (Internal Broker is on 1884) ---
INTERNAL_MQTT_USER=alex
INTERNAL_MQTT_PASS=your_secure_mqtt_password
NBIOT_MQTT_BROKER=catchsensor_app
NBIOT_MQTT_PORT=1884
